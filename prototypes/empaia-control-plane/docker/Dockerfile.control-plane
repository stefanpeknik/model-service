FROM python:3.12-slim

ARG FASTAPI_VERSION=0.136.1
ARG UVICORN_VERSION=0.46.0

RUN groupadd --gid 10001 model-service && \
    useradd --uid 10001 --gid 10001 --no-create-home model-service && \
    pip install --no-cache-dir \
        "fastapi==${FASTAPI_VERSION}" \
        "uvicorn==${UVICORN_VERSION}"

WORKDIR /app
COPY --chown=10001:10001 control_plane /app/control_plane

USER 10001:10001
EXPOSE 8080

CMD ["uvicorn", "control_plane.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]

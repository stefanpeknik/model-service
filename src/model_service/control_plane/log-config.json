{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "request_id": {
      "()": "asgi_correlation_id.CorrelationIdFilter",
      "default_value": null
    },
    "execution_id": {
      "()": "model_service.contracts.log_context.ExecutionIdFilter"
    }
  },
  "formatters": {
    "json": {
      "()": "model_service.contracts.log_context.json_formatter"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": [
        "request_id",
        "execution_id"
      ]
    }
  },
  "loggers": {
    "model_service": {
      "level": "INFO"
    },
    "uvicorn": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "level": "INFO"
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": [
      "stdout"
    ]
  }
}

FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM python:3.12-slim

COPY --from=uv /uv /usr/local/bin/uv

RUN uv pip install --system --no-cache \
    "fastapi>=0.115.0" \
    "httpx>=0.27.0" \
    "lz4>=4.4.5" \
    "pydantic-settings>=2.10.0,<3" \
    "pyyaml>=6.0.2" \
    "uvicorn>=0.30.0"

WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY src/model_service model_service

RUN groupadd --gid 10001 scheduler \
    && useradd --uid 10001 --gid scheduler --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin scheduler

USER 10001:10001
EXPOSE 8080

CMD ["uvicorn", "model_service.facade.main:app", "--host", "0.0.0.0", "--port", "8080"]

ARG CPU_BASE_IMAGE=docker.io/rayproject/ray:2.58.0-py312
FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

FROM ${CPU_BASE_IMAGE}

COPY --from=uv /uv /usr/local/bin/uv

USER root

ARG UV_HTTP_TIMEOUT=300
ARG UV_CONCURRENT_DOWNLOADS=4

# The Ray head and CPU workers: the analysis runner runs here, and Serve
# imports every app here, the models' included. The analysis-runner,
# served-models and cpu extras, pinned by uv.lock; the base image's Ray
# stays. The EMPAIA SDK is a git dependency on a GitLab fork, so build with
# `--ssh default`.
COPY pyproject.toml uv.lock /tmp/project/
RUN --mount=type=ssh cd /tmp/project \
    && export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new" \
        GIT_CONFIG_COUNT=1 \
        GIT_CONFIG_KEY_0=url.git@gitlab.ics.muni.cz:rationai/digital-pathology/production/services/models.git.insteadOf \
        GIT_CONFIG_VALUE_0=https://github.com/AigoPath/EMPAIA-Models.git \
    && uv export --frozen --no-dev --extra analysis-runner --extra served-models --extra cpu \
        --no-emit-project --no-emit-package ray \
        --format pylock.toml -o /tmp/pylock.ray-cpu.toml \
    && uv pip install --python /home/ray/anaconda3/bin/python --no-cache \
        -r /tmp/pylock.ray-cpu.toml \
    && rm -rf /tmp/project /tmp/pylock.ray-cpu.toml

USER 1000

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}

WORKDIR /app
ENV PYTHONPATH=/app
COPY src/components components
COPY src/model_service model_service

RUN /home/ray/anaconda3/bin/python -c "\
import onnxruntime, timm, torch, torchvision; \
from ratiopath.masks.mask_builders import MaskBuilder; \
from ratiopath.openslide import OpenSlide; \
from ratiopath.tiling import grid_tiles; \
import model_service.analysis_runner.serve; \
import model_service.served_model.serve; \
from model_service.registry import default_registry; default_registry(); \
assert torch.__version__.endswith('+cpu'), torch.__version__"

FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM python:3.12-slim

COPY --from=uv /uv /usr/local/bin/uv

# The api extra, pinned by uv.lock. Ray is pruned: the EMPAIA SDK declares it,
# but the API never runs it. The SDK itself comes from its build context.
COPY pyproject.toml uv.lock /tmp/project/
RUN cd /tmp/project \
    && uv export --frozen --no-dev --extra api --no-emit-project \
        --no-emit-package rationai-empaia --prune ray -o /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt \
    && rm -rf /tmp/project /tmp/requirements.txt

COPY --from=empaia-sdk pyproject.toml README.md LICENSE /opt/empaia-sdk/
COPY --from=empaia-sdk rationai /opt/empaia-sdk/rationai
RUN uv pip install --system --no-cache --no-deps /opt/empaia-sdk

WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY src/model_service model_service
# The lock's snapshot of the SDK's dependencies must still satisfy the SDK.
RUN python -c "import model_service.api.app_factory"

RUN groupadd --gid 10001 api \
    && useradd --uid 10001 --gid api --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin api

USER 10001:10001
EXPOSE 8080

CMD ["uvicorn", "model_service.api.main:app", "--host", "0.0.0.0", "--port", "8080", "--log-config", "/app/model_service/api/log-config.json"]

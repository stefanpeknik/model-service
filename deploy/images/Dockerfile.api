FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

# The api extra, pinned by uv.lock, in a virtual environment. Ray is pruned:
# the EMPAIA SDK declares it, but the API never runs it. The SDK is a git
# dependency on a GitLab fork, so build with `--ssh default`.
FROM python:3.12-slim AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client \
    && rm -rf /var/lib/apt/lists/*
ENV GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new" \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=url.git@gitlab.ics.muni.cz:rationai/digital-pathology/production/services/models.git.insteadOf \
    GIT_CONFIG_VALUE_0=https://github.com/AigoPath/EMPAIA-Models.git
COPY pyproject.toml uv.lock /tmp/project/
RUN --mount=type=ssh cd /tmp/project \
    && uv export --frozen --no-dev --extra api --no-emit-project --prune ray \
        -o /tmp/requirements.txt \
    && uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-cache --no-deps \
        -r /tmp/requirements.txt

FROM python:3.12-slim

COPY --from=dependencies /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY src/model_service model_service
# The lock's snapshot of the SDK's dependencies must still satisfy the SDK.
RUN python -c "import model_service.api.app_factory"

RUN groupadd --gid 10001 api \
    && useradd --uid 10001 --gid api --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin api

USER 10001:10001
EXPOSE 8080

CMD ["uvicorn", "model_service.api.main:app", "--host", "0.0.0.0", "--port", "8080", "--log-config", "/app/model_service/api/log-config.json"]

FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM python:3.12-slim

COPY --from=uv /uv /usr/local/bin/uv

# uv.lock pins the API's dependencies; the `serve` extra (Ray Serve, models)
# is left out. The EMPAIA SDK is a path dependency on the sibling checkout, so
# it comes from the `empaia-sdk` build context; its own dependencies are locked.
COPY pyproject.toml uv.lock /tmp/lock/
RUN uv export --project /tmp/lock --frozen --no-dev --no-emit-project \
        --no-emit-package rationai-empaia -o /tmp/lock/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/lock/requirements.txt \
    && rm -rf /tmp/lock
COPY --from=empaia-sdk pyproject.toml README.md LICENSE /opt/empaia-sdk/
COPY --from=empaia-sdk rationai /opt/empaia-sdk/rationai
RUN uv pip install --system --no-cache --no-deps /opt/empaia-sdk

WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY src/model_service model_service

RUN groupadd --gid 10001 api \
    && useradd --uid 10001 --gid api --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin api

USER 10001:10001
EXPOSE 8080

CMD ["uvicorn", "model_service.api.main:app", "--host", "0.0.0.0", "--port", "8080"]

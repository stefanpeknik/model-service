FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM python:3.12-slim

COPY --from=uv /uv /usr/local/bin/uv

RUN uv pip install --system --no-cache \
    "alembic>=1.13.0,<2" \
    "cryptography>=45.0.0" \
    "fastapi>=0.115.0" \
    "httpx>=0.27.0" \
    "psycopg[binary]>=3.2.0" \
    "pyvips[binary]>=3.0.0" \
    "pyyaml>=6.0.2" \
    "sqlalchemy[asyncio]>=2.0.36,<2.1" \
    "uvicorn>=0.30.0"

WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY model_service model_service
COPY execution_scheduler execution_scheduler
COPY integrations integrations
COPY workflow_execution workflow_execution
COPY workflows workflows
COPY workflow-definitions workflow-definitions

USER 10001:10001
EXPOSE 8080

CMD ["uvicorn", "model_service.main:app", "--host", "0.0.0.0", "--port", "8080"]

FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM docker.io/rayproject/ray:2.58.0-py312

COPY --from=uv /uv /usr/local/bin/uv

COPY --from=empaia-sdk pyproject.toml README.md LICENSE /opt/empaia-sdk/
COPY --from=empaia-sdk rationai /opt/empaia-sdk/rationai
RUN uv pip install --python /home/ray/anaconda3/bin/python --no-cache "aiohttp>=3.9.5,<4" \
    && uv pip install --python /home/ray/anaconda3/bin/python --no-cache --no-deps /opt/empaia-sdk

RUN uv pip install --python /home/ray/anaconda3/bin/python --no-cache \
    "fastapi>=0.115.0" \
    "httpx>=0.28.0" \
    "lz4>=4.4.4" \
    "openslide-bin" \
    "pillow>=11.3.0" \
    "pyvips[binary]>=3.0.0" \
    "pyyaml>=6.0.2" \
    "ratiopath>=1.0.3"

WORKDIR /app
COPY validation validation
COPY integrations integrations
COPY workflow_execution workflow_execution
COPY workflows workflows
COPY workflow-definitions workflow-definitions

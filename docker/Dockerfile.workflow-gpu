ARG GPU_BASE_IMAGE=docker.io/rayproject/ray:2.58.0-py312-gpu
FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM ${GPU_BASE_IMAGE} AS runtime-dependencies

COPY --from=uv /uv /usr/local/bin/uv

USER root
ARG UV_HTTP_TIMEOUT=300
ARG UV_CONCURRENT_DOWNLOADS=4
ARG UV_NO_CACHE=true
ARG UV_CACHE_DIR=/home/ray/.cache/uv

RUN uv pip install --python /home/ray/anaconda3/bin/python \
    "fastapi>=0.115.0" "httpx>=0.27.0" "pydantic>=2.10.0" "pyyaml>=6.0.2" \
    "onnxruntime-gpu==1.23.2" \
    "mlflow<3.0" "lz4>=4.4.5" "ratiopath==1.0.3" \
    "torch==2.8.0" "torchvision==0.23.0" \
    "openslide-bin==4.0.1.2" "pyvips[binary]>=3.0.0"

FROM runtime-dependencies

ARG TENSORRT_WHEEL_URL=https://pypi.nvidia.com/tensorrt-cu12-libs/tensorrt_cu12_libs-10.9.0.34-py2.py3-none-manylinux_2_28_x86_64.whl#sha256=4a82f0bda2874596f202f6edc8dae99b86a3c4ec2fa142a9c847c4d3a57864a0

# PyPI provides a download stub for these libraries; use NVIDIA's binary wheel.
RUN uv pip install --python /home/ray/anaconda3/bin/python --no-cache \
    "tensorrt-cu12==10.9.0.34" "tensorrt-cu12-libs @ ${TENSORRT_WHEEL_URL}"

USER 1000

ENV NVIDIA_PYTHON_LIB=/home/ray/anaconda3/lib/python3.12/site-packages/nvidia
ENV LD_LIBRARY_PATH="/home/ray/anaconda3/lib/python3.12/site-packages/tensorrt_libs:${NVIDIA_PYTHON_LIB}/cudnn/lib:${NVIDIA_PYTHON_LIB}/cublas/lib:${NVIDIA_PYTHON_LIB}/cuda_runtime/lib:${NVIDIA_PYTHON_LIB}/cufft/lib:${NVIDIA_PYTHON_LIB}/curand/lib:${NVIDIA_PYTHON_LIB}/cuda_nvrtc/lib:${NVIDIA_PYTHON_LIB}/nvjitlink/lib:${LD_LIBRARY_PATH}"

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}

WORKDIR /app
ENV PYTHONPATH=/app
COPY models models
COPY providers providers
COPY misc misc
COPY integrations integrations
COPY workflow_execution workflow_execution
COPY workflow-definitions workflow-definitions
